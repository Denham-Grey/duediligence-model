# Copy to .env.local (git-ignored) and fill in. On Vercel, set the same names under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — prototype settings (defaults shown)
# NEXT_PUBLIC_ORG_NAME=Denham + Grey
# NEXT_PUBLIC_REPORTING_YEAR=2026
# NEXT_PUBLIC_SHOW_GUIDANCE=true
# NEXT_PUBLIC_ENFORCE_JUSTIFICATION=true
